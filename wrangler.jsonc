{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forkcaster",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"routes": [
		{ "pattern": "forkcaster.xyz", "custom_domain": true },
		{ "pattern": "warpcats.com", "custom_domain": true }
	],
	// SHIM_POTATO_BASE: the FULL shim fleet, one leg per comma-separated
	// base. Var order = stagger/primary order — first entry leads at 0ms.
	// Removing a base retires it from every raced read. A host's stats id
	// is its hostname label (shim-potato-4.artlu.xyz writes "shim-potato-4"),
	// so members can leave and return without renumbering anyone else.
	// Nov 9 2026 cutover: shim.artlu.xyz is a SELF-HOSTED potato now and
	// leads the fleet — the Render+Neon cloud reader behind that hostname
	// was decommissioned Nov 2026 (the "shim-cloud" seat id survives only
	// as decaying stats/transparency vocabulary; the label "shim" was
	// un-reserved for this host at the cutover). shim-potato.artlu.xyz is
	// back from its Nov 7 re-deploy, in the lead slot behind shim.
	// shim-potato-4/-5 were dropped in the same cutover — their ids stay
	// theirs if they ever return. "shim-potato-3" is not a host — cloud's
	// pre-rename positional series; do not give a new machine that name.
	// The var is REQUIRED in production: empty = the legacy single-shim
	// roster (the default host only).
	"vars": { "PRIMARY_ORIGIN": "https://forkcaster.xyz", "SHIM_POTATO_BASE": "https://shim.artlu.xyz,https://shim-potato.artlu.xyz,https://shim-potato-2.artlu.xyz" },
	"assets": { "not_found_handling": "none" },
	"observability": { "enabled": true },
	"analytics_engine_datasets": [{ "binding": "RACE_STATS" }, { "binding": "CLICK_STATS" }, { "binding": "FID_RACE" }],
	"upload_source_maps": true,
	"services": [{ "binding": "UNFURL", "service": "unfurl" }]
}
