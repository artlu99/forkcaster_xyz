{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forkcaster",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"routes": [
		{ "pattern": "forkcaster.xyz", "custom_domain": true },
		{ "pattern": "warpcats.com", "custom_domain": true }
	],
	// SHIM_POTATO_BASE: the FULL shim fleet, one leg per comma-separated
	// base. Var order = stagger/primary order — first entry leads at 0ms;
	// shim-potato leads. Removing a base retires it from every raced read.
	// Cloud's base was pruned Nov 2026 (the shim-cloud retirement): no
	// fleet leg, no new datapoints — the Render host is decommissioned,
	// and the id survives only as decaying stats history (the 168h
	// window). The var is REQUIRED in production now: empty = the legacy
	// cloud-only roster, which points at the retired host.
	"vars": { "PRIMARY_ORIGIN": "https://forkcaster.xyz", "SHIM_POTATO_BASE": "https://shim-potato.artlu.xyz,https://shim-potato-2.artlu.xyz" },
	"assets": { "not_found_handling": "none" },
	"observability": { "enabled": true },
	"analytics_engine_datasets": [{ "binding": "RACE_STATS" }, { "binding": "CLICK_STATS" }, { "binding": "FID_RACE" }],
	"upload_source_maps": true,
	"services": [{ "binding": "UNFURL", "service": "unfurl" }]
}
