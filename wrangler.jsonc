{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "forkcaster",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-06",
	"routes": [
		{ "pattern": "forkcaster.xyz", "custom_domain": true },
		{ "pattern": "warpcats.com", "custom_domain": true }
	],
	// SHIM_POTATO_BASE: the FULL shim fleet, one leg per comma-separated
	// base (cloud-retirement cutover). Var order = stagger/primary order —
	// first entry leads at 0ms; shim-potato leads, cloud trails as a
	// member. Removing a base retires it from every raced read; empty =
	// the legacy cloud-only roster. Prune cloud's base here (then
	// decommission the host) when the fleet is ready to stand alone.
	"vars": { "PRIMARY_ORIGIN": "https://forkcaster.xyz", "SHIM_POTATO_BASE": "https://shim-potato.artlu.xyz,https://shim.artlu.xyz" },
	"assets": { "not_found_handling": "none" },
	"observability": { "enabled": true },
	"analytics_engine_datasets": [{ "binding": "RACE_STATS" }, { "binding": "CLICK_STATS" }, { "binding": "FID_RACE" }],
	"upload_source_maps": true,
	"services": [{ "binding": "UNFURL", "service": "unfurl" }]
}
