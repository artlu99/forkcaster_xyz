# forkcaster race-stats script env — copy to `.env` and fill in.
# `.env` is gitignored; never commit real values. `bun` auto-loads `.env`.

# ⚠️ names are wrangler-inert ON PURPOSE: bun auto-loads .env into every
# `bun run` process, and CLOUDFLARE_* names collide with wrangler's auth env
# (an encrypted .env broke `bun run deploy` with "Invalid account ID").
ANALYTICS_ACCOUNT_ID=

# API token — MUST be a User token (dash.cloudflare.com/profile/api-tokens):
# Account Owned Tokens are rejected by the AE SQL endpoint (403 code 10000).
# Create a Custom Token with scope: Account | Account Analytics | Read.
# Nothing more: KV is lmdis now, so no KV:Edit / Workers:Edit scopes.
ANALYTICS_API_TOKEN=

# lmdis (https://github.com/artlu99/lmdis) — snapshot store
LMDIS_URL=https://lmdis.artlu.xyz
LMDIS_REST_TOKEN=

# optional — defaults shown
#STATS_WINDOW_HOURS=168
#STATS_KEY=race-stats
#FID_STATS_KEY=fid-race
